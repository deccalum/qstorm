Documentation:
  CommentFormat: Doxygen

CompileFlags:
  Add: [-ferror-limit=0, -Wno-zero-length-array]
  Remove: [-freflection]

---
If:
  PathMatch: [
    src/io/database\.(h|cpp),
    qr/qr/.*\.hpp,
    ]
Diagnostics:
  Suppress: [no_member, ref_non_value, undeclared_var_use, c23-extensions, typename_requires_specqual,blocks_disable, nonfunction_block_type, expected_capture, expected_qualified_after_typename,expected_expression, expected, unused-parameter, auto_fn_used_before_defined, expected_unqualified_id]

---
If:
  PathMatch: [qr/qr/.*\.hpp]
Diagnostics:
  Suppress: [iterating_expansion_stmt_unsupported, expr_not_cce, ovl_no_viable_function_in_call]
